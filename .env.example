# Server Authentication Secret
AUTH_SECRET=vnqt_secret_jwt_auth_key_2026

# MongoDB Database Configuration
MONGODB_DB_NAME=vietnam_quoc_tu
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/?retryWrites=true&w=majority

# Google Gemini API Key (For AI Translation and Audio generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Daily Visitor Salt for Privacy-preserving SHA-256 HMAC Fingerprinting
VISITOR_HASH_SALT=vnqt_daily_salt_secret_key_2026

# Optional: MapTiler API Key for enhanced 3D terrain
MAPTILER_API_KEY=
VITE_MAPTILER_KEY=

# Optional: VietMap Maps API Key (https://maps.vietmap.vn/console-v2/)
VITE_VIETMAP_API_KEY=
